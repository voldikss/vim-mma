"Shebang
syntax match mmaShebang "#!\s*.\+"

"Numbers
syntax match mmaNumber "\<\%(\d\+\.\=\d*\|\d*\.\=\d\+\)\>"
syntax match mmaNumber "\d\+`\{1,2}\d*\%(\d\@!\.\|\>\)"
syntax match mmaNumber "[1-9]\d*\^\^"
syntax match mmaNumber "\%(\d\+\.\=\d*\|\d*\.\=\d\+\)\*\^[-+]\=\%(\d\+\.\=\d*\|\d*\.\=\d\+\)"

"Strings
syntax region mmaString start=/"/ skip=/\\\@<!\\\%(\\\\\)*"/ end=/"/ skipempty

"OPERATORS
"Replace: Replace, ReplaceAll
syntax match mmaOperator "/\{1,2}."
"Call: Prefix, Apply, Map, MapAll, Postfix, Infix, Composition, RightComposition
syntax match mmaOperator "@\{1,3}"
syntax match mmaOperator "/\{1,2}@\="
syntax match mmaOperator "\~"
syntax match mmaOperator "[@/]\*"
"Comparison: Greater, Less, GreaterEqual, LessEqual, Equal, Unequal, SameQ, UnsameQ
syntax match mmaOperator "[<>]=\="
syntax match mmaOperator "=\=[=!]="
"Logical: Not, Or, And
syntax match mmaOperator "\%(!\|||\|&&\)"
"Assignment: Set, SetDelayed, UpSet, UpSetDelayed, TagSet, Unset, AddTo, SubtractFrom, TimesBy, DivideBy
syntax match mmaOperator "\^\=:\=="
syntax match mmaOperator "\%(/:\|=\.\)"
syntax match mmaOperator "[+-\*/]="
"Rule: Rule, RuleDelayed, TwoWayRule
syntax match mmaOperator "\%(-\|:\|<-\)>"
"Condition: Condition
syntax match mmaOperator "/;"
"Repeat: Repeated, RepeatedNull
syntax match mmaOperator "\.\{2,3}"
"Arithetic: Plus, Minus, Subtract, Multiply, Divide, Power, Dot, Factorial, Factorial2, Derivative, NonCommutativeMultiply, Increment, PreIncrement, Decrement, PreDecrement
syntax match mmaOperator "\%([+-]\|\*\|/\|'\|\^\|\.\|!!\|++\|--\|\*\*\)"
"Flow: Get, Put, PutAppend
syntax match mmaOperator "\%(<<\|>>\|>>>\)"
"String: StringJoin, StringExpression, Alternatives
syntax match mmaOperator "\%(<>\||\|\~\~\)"
"Span & Compound: Span & CompoundExpression
syntax match mmaOperator ";\{1,2}"
"Function: Function
syntax match mmaOperator "&"
"Definition: Definition, FullDefinition
syntax match mmaOperator "?\{1,2}"

"User Symbols
syntax match mmaSymbol "[^0-9"][A-Za-z0-9`$]\+\s*\%([@[]\|/:\|/\=/@\)\@=" contains=mmaOperator,mmaSystemSymbol,mmaBrackets,mmaError
syntax match mmaSymbol "\<[^0-9][A-Za-z0-9`$]\+\>" contains=mmaOperator,mmaSystemSymbol,mmaBrackets,mmaError
syntax match mmaSymbol "\~\s*[^~]\+\s*\~"ms=s+1,me=e-1 contains=mmaOperator,mmaSystemSymbol,mmaBrackets,mmaError
syntax match mmaSymbol "//\s*[A-Za-z0-9`$]\+"ms=s+2 contains=mmaOperator,mmaSystemSymbol,mmaBrackets,mmaError

"Comments and TODOs
syntax keyword mmaTodo TODO FIX FIXME BUG contained
syntax region mmaComment start=/(\*/ end=/\*)/ skipempty contains=mmaComment, mmaTodo

"Slots & Slotsequences
syntax match mmaSlot "^\@<!#\%(#\d*\|\d\+\)\="
syntax match mmaSlot "^\@<!#\%([A-Za-z0-9`$]*\)"

"Patterns
syntax match mmaPattern     "[A-Za-z0-9`$]*_\{1,3}\%([A-Za-z0-9`$]\+\)\="
syntax match mmaPatternName "[A-Za-z0-9`$]\+\s*:[^:=>]"me=e-2
syntax match mmaPattern     "[A-Za-z0-9`]*_\+\%([A-Za-z0-9`]\+\)"

"Brackets
syntax match mmaBrackets "[({\[}\])]"      contained
syntax match mmaBrackets "\%(<|\||>\)"     contained
syntax match mmaBrackets "\%(\[\[\|\]\]\)" contained
syntax match mmaBrackets "\%(\\(\|\\)\)"   contained

"Special characters
syntax match mmaSpecial "\\\[[A-Za-z0-9]\+\]"
syntax match mmaSpecial "\\\%(\o\{3}\|\.\x{2}\|\.\x\{4}\)"

"Messages
syntax match mmaMessage "::\s*[A-Za-z0-9]\+"hs=s+2

"Errors
syntax match mmaError "\%([/]{3,}\|[&:|+*?~-]\{3,}\|[.=]\{4,}\|_\@<=\.\{2,}\|`\{3,}\)" contained

hi def link mmaShebang      PreProc
hi def link mmaComment      Comment
hi def link mmaSymbol       Identifier
hi def link mmaSystemSymbol Function
hi def link mmaOperator     Operator
hi def link mmaSlot         Operator
hi def link mmaString       String
hi def link mmaSpecial      Special
hi def link mmaNumber       Number
hi def link mmaPattern      Type
hi def link mmaPatternName  Type
hi def link mmaError        Error
hi def link mmaBracket      Normal
hi def link mmaTodo         Todo
hi def link mmaMessage      Type

let b:current_syntax = "mma"

let &cpo = s:cpo_save
unlet s:cpo_save
